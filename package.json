  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test mocha",
    "test:watch": "mocha --require mocha.config.js 'test/**/*.spec.ts' --watch --watch-files src/,test/ --timeout 10000",
    "test:cov": "nyc mocha --require mocha.config.js 'test/**/*.spec.ts' --timeout 10000",
    "test:debug": "mocha --require mocha.config.js --inspect-brk 'test/**/*.spec.ts'",
    "test:e2e": "mocha --require mocha.config.js 'test/e2e/**/*.spec.ts' --timeout 10000"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
